<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="map_path" default="$(env HOME)/Ben/Thesis/Electrans_project/maps/tractor_trailer_rl_lab_map" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="electrans_robot_vehicle" description="vehicle model name"/>
  <arg name="sensor_model" default="electrans_robot_sensor_kit" description="sensor model name"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)" description="vehicle specific ID"/>
  <arg name="data_path" default="$(env HOME)/autoware_data" description="packages data and artifacts directory path"/>

  <!-- launch module preset -->
  <!-- Use 'default' for standard single-vehicle lane driving (no trailer bridge). -->
  <arg name="planning_module_preset" default="default" description="planning module preset"/>
  <arg name="control_module_preset" default="default" description="control module preset"/>

  <!-- Optional parameters -->
  <arg name="vehicle" default="true" description="launch vehicle"/>
  <arg name="system" default="true" description="launch system"/>
  <arg name="map" default="true" description="launch map"/>
  <arg name="sensing" default="true" description="launch sensing"/>
  <arg name="localization" default="true" description="launch localization"/>
  <arg name="perception" default="true" description="launch perception"/>
  <arg name="planning" default="true" description="launch planning"/>
  <arg name="control" default="true" description="launch control"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="launch_vehicle_interface" default="true"/>
  <!-- Set false when sensor drivers are already running (e.g. hunter_launch sensors.launch.py) -->
  <arg name="launch_sensing_driver" default="true" description="launch sensor hardware drivers"/>
  <arg name="lanelet2_map_file" default="lanelet2_map.osm" description="lanelet2 map file name"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd" description="pointcloud map file name"/>
  <arg name="launch_system_monitor" default="false" description="launch system monitor"/>
  <arg name="launch_dummy_diag_publisher" default="false" description="launch dummy diag publisher"/>
  <!-- No desktop on the Jetson: default RViz off, use foxglove_bridge instead. -->
  <arg name="rviz" default="false" description="launch rviz"/>

  <!-- Trailer attached? Single switch for all trailer-only subsystems:
         * lidar hitch-angle estimator + trailer self-filter (sensing chain,
           gated via the ELECTRANS_TRAILER env var set below — see
           robosense_Helios.launch.xml),
         * the trailer mesh visualizer (added below).
       false (default) = trailer PHYSICALLY DETACHED: estimator/self-filter off
       (frees the Jetson), bridge pins hitch β=0 internally, no trailer drawn —
       this is the current working real-robot config. true = trailer attached. -->
  <arg name="trailer" default="false" description="trailer attached: enable hitch estimator + self-filter + trailer visualizer"/>
  <!-- Propagate to the deep sensing leaf (robosense_Helios.launch.xml) without
       threading an arg through 6 include levels. start_robot.sh also exports
       this directly, so it works whether launched via the script or via
       `ros2 launch ... trailer:=true`. -->
  <set_env name="ELECTRANS_TRAILER" value="$(var trailer)"/>

  <!-- RL bridge (electrans_rl_bridge) parameters. With control:=true (default) the
       control component includes electrans_rl_bridge.launch.xml, so these must point
       at the e2e_rl tree + TD3 models on THIS machine (the Jetson). -->
  <arg name="e2e_rl_path" default="/home/electrans_robot/Ben/e2e_rl" description="e2e_rl source tree on this machine"/>
  <arg name="td3_model_path" default="$(env HOME)/Ben/Thesis/Electrans_project/lab_models_ttrl_deploy/forward_trailer/best_model.policy.pth" description="forward TD3 policy .pth"/>
  <arg name="td3_reverse_model_path" default="$(env HOME)/Ben/Thesis/Electrans_project/lab_models_ttrl_deploy/reverse_trailer/best_model.policy.pth" description="reverse TD3 policy .pth"/>
  <arg name="action_space" default="stop_signal" description="fixed_speed | variable_speed"/>
  <arg name="control_rate_hz" default="10.0" description="RL control loop rate"/>
  <arg name="bev_publish_rate_hz" default="4.0" description="debug BEV render/publish rate; 0 disables"/>
  <!-- Relay the BEV image onto the RViz RecognitionResultOnImage panel topic so
       it shows in the main Autoware RViz. Safe to default true on the real
       robot: perception (and thus traffic-light recognition) is off, so nothing
       else publishes on that topic. -->
  <arg name="relay_bev_to_rviz_panel" default="true" description="show BEV in RViz image panel"/>
  <arg name="default_velocity_mps" default="0.6" description="fixed-speed fallback velocity"/>
  <arg name="forward_horizon_m" default="50.0" description="centerline lookahead distance"/>
  <arg name="centerline_resolution_m" default="0.5" description="centerline interpolation resolution"/>
  <arg name="world_scale" default="1.0" description="position scaling applied before the env"/>

  <group scoped="false">
    <include file="$(find-pkg-share autoware_launch)/launch/autoware.launch.xml">
      <arg name="map_path" value="$(var map_path)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <arg name="planning_module_preset" value="$(var planning_module_preset)"/>
      <arg name="control_module_preset" value="$(var control_module_preset)"/>
      <arg name="launch_vehicle" value="$(var vehicle)"/>
      <arg name="launch_map" value="$(var map)"/>
      <arg name="launch_sensing" value="$(var sensing)"/>
      <arg name="launch_localization" value="$(var localization)"/>
      <arg name="launch_perception" value="$(var perception)"/>
      <arg name="launch_planning" value="$(var planning)"/>
      <arg name="launch_control" value="$(var control)"/>
      <arg name="use_sim_time" value="false"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <arg name="vehicle_id" value="$(var vehicle_id)"/>
      <arg name="launch_vehicle_interface" value="$(var launch_vehicle_interface)"/>
      <arg name="launch_system" value="$(var system)"/>
      <arg name="system_run_mode" value="online"/>
      <arg name="launch_system_monitor" value="$(var launch_system_monitor)"/>
      <arg name="launch_dummy_diag_publisher" value="$(var launch_dummy_diag_publisher)"/>
      <arg name="diagnostic_graph_aggregator_graph_path" value="$(find-pkg-share autoware_launch)/config/system/diagnostics/autoware-main.yaml"/>
      <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
      <arg name="pointcloud_map_file" value="$(var pointcloud_map_file)"/>
      <arg name="launch_sensing_driver" value="$(var launch_sensing_driver)"/>
      <!-- RL bridge paths/knobs forwarded to tier4_control_component -> electrans_rl_bridge -->
      <arg name="e2e_rl_path" value="$(var e2e_rl_path)"/>
      <arg name="td3_model_path" value="$(var td3_model_path)"/>
      <arg name="td3_reverse_model_path" value="$(var td3_reverse_model_path)"/>
      <arg name="action_space" value="$(var action_space)"/>
      <arg name="control_rate_hz" value="$(var control_rate_hz)"/>
      <arg name="bev_publish_rate_hz" value="$(var bev_publish_rate_hz)"/>
      <arg name="relay_bev_to_rviz_panel" value="$(var relay_bev_to_rviz_panel)"/>
      <arg name="default_velocity_mps" value="$(var default_velocity_mps)"/>
      <arg name="forward_horizon_m" value="$(var forward_horizon_m)"/>
      <arg name="centerline_resolution_m" value="$(var centerline_resolution_m)"/>
      <arg name="world_scale" value="$(var world_scale)"/>
      <arg name="rviz" value="$(var rviz)"/>
      <arg name="rviz_respawn" value="false"/>
    </include>
  </group>

  <!-- Trailer mesh visualizer (real robot). In sim this comes from
       tier4_simulator_component; the real-robot launch graph never included it,
       which is why the trailer wasn't drawn. It renders the trailer + hitch as
       a MarkerArray on /visualization/trailer_state from the real hitch
       estimator's /vehicle/trailer_state and /localization/kinematic_state.
       Geometry defaults to electrans_robot_vehicle_description's
       simulator_model.param.yaml (same file the sim uses → identical shape). -->
  <group if="$(var trailer)">
    <include file="$(find-pkg-share autoware_trailer_state_visualizer)/launch/trailer_state_visualizer.launch.py"/>
  </group>
</launch>
