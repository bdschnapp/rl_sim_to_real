<launch>
  <!-- Params -->
  <arg name="launch_driver" default="true"/>
  <arg name="model" default="Helios"/>
  <arg name="max_range" default="150.0"/>
  <arg name="min_range" default="0.2"/>
  <arg name="frame_id" default="robosense"/>
  <arg name="output_topic" default="/sensing/pointcloud/robosense"/>
  <arg name="return_mode" default="SingleStrongest"/>
  <arg name="sensor_ip" default="192.168.1.200"/>
  <arg name="host_ip" default="255.255.255.255"/>
  <arg name="data_port" default="2368"/>
  <arg name="gnss_port" default="7788"/>
  <arg name="scan_phase" default="0.0"/>
  <arg name="cloud_min_angle" default="0"/>
  <arg name="cloud_max_angle" default="360"/>
  <arg name="vehicle_mirror_param_file"/>
  <arg name="container_name" default="robosense_node_container"/>
  <arg name="udp_only" default="false"/>
  <!-- Trailer nodes. The hitch_angle_estimator burns ~70% of a CPU core
       scanning for the trailer face, and the trailer_self_filter removes
       trailer points from the lidar cloud. With the trailer PHYSICALLY
       DETACHED both are useless: the estimator just logs "Not enough trailer
       face points" and publishes nothing, and there are no trailer points to
       filter. They default OFF here to free the Jetson. The RL bridge defaults
       hitch β=0 internally, so the observation is unchanged.
       >>> When the trailer is reattached, set both back to true. <<< -->
  <arg name="use_trailer_self_filter" default="false"/>
  <arg name="use_hitch_angle_estimator" default="false"/>
  <arg name="trailer_self_filter_param_path" default="$(find-pkg-share lidar_hitch_angle)/config/trailer_self_filter.param.yaml"/>

  <include file="$(find-pkg-share electrans_robot_sensor_launch)/launch/nebula_node_container.launch.py">
    <arg name="launch_driver" value="$(var launch_driver)"/>
    <arg name="sensor_model" value="$(var model)"/>
    <arg name="return_mode" value="$(var return_mode)"/>
    <arg name="max_range" value="$(var max_range)"/>
    <arg name="min_range" value="$(var min_range)"/>
    <arg name="frame_id" value="$(var frame_id)"/>
    <arg name="output_topic" value="$(var output_topic)"/>
    <arg name="sensor_ip" value="$(var sensor_ip)"/>
    <arg name="host_ip" value="$(var host_ip)"/>
    <arg name="data_port" value="$(var data_port)"/>
    <arg name="scan_phase" value="$(var scan_phase)"/>
    <arg name="cloud_min_angle" value="$(var cloud_min_angle)"/>
    <arg name="cloud_max_angle" value="$(var cloud_max_angle)"/>
    <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
    <arg name="use_intra_process" value="true"/>
    <!-- Single-threaded container was only loading 2/6 composable nodes (glog + driver);
         the remaining 4 (crop_box_filter_self / mirror, distortion_corrector, ring_outlier_filter)
         silently failed to load and the lidar pipeline died at /rslidar_points_front. -->
    <arg name="use_multithread" value="true"/>
    <arg name="container_name" value="$(var container_name)"/>
    <arg name="udp_only" value="$(var udp_only)"/>
    <arg name="use_trailer_self_filter" value="$(var use_trailer_self_filter)"/>
    <arg name="use_hitch_angle_estimator" value="$(var use_hitch_angle_estimator)"/>
    <arg name="trailer_self_filter_param_path" value="$(var trailer_self_filter_param_path)"/>
    <arg name="diag_span" value="1000"/>
  </include>
</launch>
