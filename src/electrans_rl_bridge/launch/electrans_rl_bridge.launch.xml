<?xml version="1.0"?>
<launch>
  <!-- Where the e2e_rl source tree is mounted/installed. The two nodes add this
       to sys.path so they can import Environments / Models / e2erl_utils. -->
  <arg name="e2e_rl_path" default="/home/electrans_robot/Ben/e2e_rl"/>
  <arg name="td3_model_path" default="$(env HOME)/Ben/Thesis/Electrans_project/lab_models_v22/models/forward/lidar_24/multiplicative/best_model.policy.pth"/>
  <arg name="td3_reverse_model_path" default="$(env HOME)/Ben/Thesis/Electrans_project/lab_models_v22/models/reverse/lidar_24/multiplicative/best_model.policy.pth"/>

  <!-- Trailer attached? trailer:=false loads the tractor-only model pair (29-D
       obs, 5-dim state); trailer:=true loads the trailer pair above (32-D).
       Default reads the ELECTRANS_TRAILER env var, which start_robot.sh exports
       and the top launch files <set_env>, so this one flag flows all the way
       down without being threaded through every intermediate launch file. -->
  <arg name="trailer" default="$(env ELECTRANS_TRAILER false)"/>
  <!-- Tractor-only checkpoints (used when trailer:=false). Must be exported
       with re_export_td3.py in tractor-only mode so their .policy_kwargs.pkl
       meta records the Environments.TractorOnly env class. -->
  <arg name="td3_model_path_tractor_only" default="$(env HOME)/Ben/Thesis/Electrans_project/lab_models_ttrl_deploy/forward_tractor_only/best_model.policy.pth"/>
  <arg name="td3_reverse_model_path_tractor_only" default="$(env HOME)/Ben/Thesis/Electrans_project/lab_models_ttrl_deploy/reverse_tractor_only/best_model.policy.pth"/>

  <!-- Lanelet2 map: must match what autoware_map_loader was given. The MVSL lab
       map is a Local-projection map (lat="" lon="" + local_x/local_y tags);
       lane_reference_node handles that internally. -->
  <arg name="map_path" default="$(env HOME)/autoware_map/mvsl"/>
  <arg name="lanelet2_map_file" default="lanelet2_map.osm"/>

  <!-- Bridge knobs -->
  <arg name="action_space" default="stop_signal"/>            <!-- fixed_speed | variable_speed | stop_signal -->
  <!-- stop_signal mode: action[1] > stop_threshold ⇒ command zero speed. The
       policy LEARNS when to stop; the bridge just listens. MUST match the
       training default (0.5 — raised from 0 so exploration episodes survive;
       see stop_signal_patch.py). -->
  <arg name="stop_threshold" default="0.8"/>
  <arg name="control_rate_hz" default="10.0"/>
  <arg name="bev_publish_rate_hz" default="4.0"/>               <!-- debug BEV render rate; 0 disables -->

  <arg name="default_velocity_mps" default="0.6"/>
  <arg name="forward_horizon_m" default="50.0"/>
  <arg name="centerline_resolution_m" default="0.5"/>
  <!-- Optional scaling applied to all positions before they reach the env.
       Default 1.0 means the env operates at real ROS coordinates. Combined
       with the e2erl_utils.config overrides in rl_bridge_node, which point
       the env window/lane/vehicle dims at the AgileX lab scale, this gives
       the policy obs values at real physical scale. Set above 1 to
       artificially upscale obs values (legacy workaround for the
       sim-real distribution mismatch when the policy was trained at
       semi-truck scale). -->
  <arg name="world_scale" default="1.0"/>

  <!-- When true, relay /rl_bridge/bev_image onto the topic the existing
       autoware.rviz RecognitionResultOnImage display already subscribes to,
       so the BEV shows up in the main Autoware RViz without a second
       rviz_default_plugins/Image display. Set false when traffic-light
       recognition is also publishing onto that topic (real-robot setups). -->
  <arg name="relay_bev_to_rviz_panel" default="false"/>

  <!-- Bridges RViz /initialpose → autoware pose-initializer service. Needed
       because default_adapi_universe (which used to do this) was deleted with
       the lifecycle stack. -->
  <node pkg="electrans_rl_bridge" exec="initialpose_shim" name="initialpose_shim" output="screen"/>

  <node pkg="electrans_rl_bridge" exec="lane_reference_node" name="lane_reference_node" output="screen">
    <param name="map_path" value="$(var map_path)"/>
    <param name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
    <param name="forward_horizon_m" value="$(var forward_horizon_m)"/>
    <param name="centerline_resolution_m" value="$(var centerline_resolution_m)"/>
  </node>

  <node pkg="electrans_rl_bridge" exec="rl_bridge_node" name="rl_bridge_node" output="screen">
    <param name="e2e_rl_path" value="$(var e2e_rl_path)"/>
    <param name="trailer" value="$(var trailer)"/>
    <param name="td3_model_path" value="$(var td3_model_path)"/>
    <param name="td3_reverse_model_path" value="$(var td3_reverse_model_path)"/>
    <param name="td3_model_path_tractor_only" value="$(var td3_model_path_tractor_only)"/>
    <param name="td3_reverse_model_path_tractor_only" value="$(var td3_reverse_model_path_tractor_only)"/>
    <param name="action_space" value="$(var action_space)"/>
    <param name="stop_threshold" value="$(var stop_threshold)"/>
    <param name="control_rate_hz" value="$(var control_rate_hz)"/>
    <param name="bev_publish_rate_hz" value="$(var bev_publish_rate_hz)"/>
    <param name="default_velocity_mps" value="$(var default_velocity_mps)"/>
    <param name="world_scale" value="$(var world_scale)"/>
  </node>

  <group if="$(var relay_bev_to_rviz_panel)">
    <node pkg="topic_tools" exec="relay" name="bev_to_rviz_panel_relay"
          args="/rl_bridge/bev_image /perception/traffic_light_recognition/traffic_light/debug/rois"
          output="screen"/>
  </group>
</launch>
